# Copy to configs/toolchain.env and edit the installation prefixes.
# These are prefixes, not bin/include/lib subdirectories.
PYTHIA8="$HOME/.local/pythia8308"
FASTJET3="$HOME/.local/fastjet-3.4.0"

# Optional source provenance recorded by make manifest.
PYTHIA8_SOURCE_TAG="pythia8308"
PYTHIA8_SOURCE_COMMIT="38ebd86865e4f25e9cf461b610f5c82d475ab77a"
# PYTHIA8_SOURCE_DIR="$HOME/path/to/pythia8308"

# Optional build controls.
CXX="g++"
BUILD_JOBS="4"
